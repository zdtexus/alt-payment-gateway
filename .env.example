DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments

# Required. Protects /admin/** (X-Admin-Key header). At least 16 characters; use a long random value.
ADMIN_API_KEY=local-admin-key-change-me

# Optional payment-service settings. Uncomment to override the defaults.
# Payment rules per method (CARD, BONUS, CRYPTO, KVIK); see README "Payment methods".
# PAYMENT_RULES_BONUS_MAX_AMOUNT=500.00
# PAYMENT_RULES_CARD_CURRENCIES=EUR,USD,PLN,UAH
# PAYMENT_RULES_CARD_MIN_AMOUNT=0.50
# DB_CONNECTION_TIMEOUT_MS=3000
# PAYMENT_PROVIDER_DEFAULT=simulated
# PAYMENT_PROVIDER_ROUTES_CARD=simulated
# PAYMENT_PROVIDER_SUCCESS_RATE=0.9
# PAYMENT_PROVIDER_LATENCY=300ms
# PAYMENT_PROVIDER_AUTHORIZATION_VALIDITY=7d
# PAYMENT_PROVIDER_FIXED_OUTCOME=approve
# PAYMENT_PROVIDER_FIXED_DECLINE_REASON=Declined by fixed provider
# PAYMENT_PROVIDER_FIXED_AUTHORIZATION_VALIDITY=7d
# PAYMENT_PROVIDER_HTTP_URL=https://payments.example.com/charge
# PAYMENT_PROVIDER_HTTP_API_KEY=
# PAYMENT_PROVIDER_HTTP_CONNECT_TIMEOUT=2s
# PAYMENT_PROVIDER_HTTP_READ_TIMEOUT=10s
# PAYMENT_PROVIDER_HTTP_WEBHOOK_SECRET=
# PAYMENT_PROVIDER_HTTP_STATUS_URL=https://payments.example.com/status
# PAYMENT_PROVIDER_HTTP_REFUND_URL=https://payments.example.com/refund
# PAYMENT_PROVIDER_HTTP_AUTHORIZE_URL=https://payments.example.com/authorize
# PAYMENT_PROVIDER_HTTP_CAPTURE_URL=https://payments.example.com/capture
# PAYMENT_PROVIDER_HTTP_VOID_URL=https://payments.example.com/void
# Re-checking PENDING payments with providers that support status queries.
# PAYMENT_RECONCILIATION_ENABLED=true
# PAYMENT_RECONCILIATION_INTERVAL=1m
# PAYMENT_RECONCILIATION_MIN_AGE=2m
# PAYMENT_RECONCILIATION_BATCH_SIZE=50
# PAYMENT_RECONCILIATION_MAX_BACKOFF=1h
# PAYMENT_RECONCILIATION_ALERT_AFTER=24h
# MAIL_TIMEOUT_MS=5000
# SMS_PROVIDER=log
# NOTIFICATION_SMS_HTTP_URL=https://sms.example.com/send
# NOTIFICATION_SMS_HTTP_API_KEY=
# NOTIFICATION_SMS_HTTP_TIMEOUT=5s

# Optional api-gateway rate limits for /api/v1/**: per API key, and per client IP across all keys.
# RATE_LIMIT_REPLENISH_RATE=10
# RATE_LIMIT_BURST_CAPACITY=20
# RATE_LIMIT_IP_REPLENISH_RATE=20
# RATE_LIMIT_IP_BURST_CAPACITY=40
# RATE_LIMIT_WEBHOOK_REPLENISH_RATE=50
# RATE_LIMIT_WEBHOOK_BURST_CAPACITY=100
# Only behind a reverse proxy or load balancer: its IPs/CIDRs, comma-separated. Empty trusts no proxy.
# TRUSTED_PROXIES=10.0.0.0/8
# REDIS_TIMEOUT=250ms
